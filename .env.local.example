# Example environment variables (do NOT commit secrets)
# Copy this file to .env.local and fill in the values. Keep .env.local out of version control.

# Gemini API key used only by the server-side proxy (/api/chat)
# Example: GEMINI_API_KEY="sk_..."
GEMINI_API_KEY=

# Port the server listens on (Cloud Run/hosting may inject this)
PORT=8080

# Node environment
NODE_ENV=development

# Optional: toggle verbose logging
LOG_LEVEL=info
