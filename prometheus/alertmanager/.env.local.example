# Local Alertmanager env file example (DO NOT COMMIT the real .env.local with secrets)
#
# Usage:
# 1) Copy this file to prometheus/alertmanager/.env.local
#    cp prometheus/alertmanager/.env.local.example prometheus/alertmanager/.env.local
# 2) Fill in the real secret values (keep this file out of git).
# 3) Optionally add prometheus/alertmanager/.env.local to your .gitignore.
# 4) Start the monitoring stack: docker compose -f docker-compose.monitor.yml up -d
#
# Notes:
# - SLACK_WEBHOOK_* values are full incoming-webhook URLs from Slack.
# - EMAIL_TO is the address Alertmanager will send emails to (if SMTP settings are configured in the Alertmanager template).
# - File permissions should be restricted: chmod 600 prometheus/alertmanager/.env.local

# Slack webhook for regular notifications (team channel)
SLACK_WEBHOOK_TEAM="https://hooks.slack.com/services/T/XXXX/YYYY"
# Slack channel to post team notifications (override in template if desired)
SLACK_CHANNEL_TEAM="#alerts"

# Slack webhook for pager/escalation notifications (high-severity)
SLACK_WEBHOOK_PAGER="https://hooks.slack.com/services/T/XXXX/ZZZZ"
# Slack channel for pager notifications
SLACK_CHANNEL_PAGER="#pager"

# Email notifications (destination address)
EMAIL_TO="ops@example.com"
